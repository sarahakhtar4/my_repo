library(sample_stdcell) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit(1, pf);
  
  cell(INV_X1) {
    area : 2.5;
    pin(A) {
      direction : input;
      capacitance : 0.8;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 20.0;
      timing() {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise : 1.2;
        cell_fall : 0.9;
        rise_transition : 0.15;
        fall_transition : 0.12;
      }
    }
  }
  
  cell(AND2_X1) {
    area : 4.0;
    pin(A) {
      direction : input;
      capacitance : 0.9;
    }
    pin(B) {
      direction : input;
      capacitance : 0.9;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 25.0;
      timing() {
        related_pin : "A B";
        timing_sense : positive_unate;
        cell_rise : 2.1;
        cell_fall : 1.8;
        rise_transition : 0.25;
        fall_transition : 0.22;
      }
    }
  }
  
  cell(NAND2_X1) {
    area : 3.5;
    pin(A) {
      direction : input;
      capacitance : 1.0;
    }
    pin(B) {
      direction : input;
      capacitance : 1.0;
    }
    pin(Y) {
      direction : output;
      max_capacitance : 30.0;
      timing() {
        related_pin : "A B";
        timing_sense : negative_unate;
        cell_rise : 1.5;
        cell_fall : 1.3;
        rise_transition : 0.18;
        fall_transition : 0.16;
      }
    }
  }
  
  cell(DFF_X1) {
    area : 8.0;
    ff(IQ, IQN) {
      next_state : "D";
      clocked_on : "CLK";
    }
    pin(D) {
      direction : input;
      capacitance : 1.2;
    }
    pin(CLK) {
      direction : input;
      capacitance : 1.5;
      clock : true;
    }
    pin(Q) {
      direction : output;
      max_capacitance : 40.0;
      timing() {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise : 2.8;
        cell_fall : 2.5;
        rise_transition : 0.30;
        fall_transition : 0.28;
      }
    }
  }
}